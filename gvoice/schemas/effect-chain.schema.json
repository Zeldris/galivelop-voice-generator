{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effect chain",
  "description": "Effect chain defined by its meaning in ffmpeg; the generator and the game apply the same filter graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference so editors can validate and complete the file."
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name",
      "description": "Chain name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      },
      "description": "Steps applied in order."
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "One effect step. Each type requires and admits only its own parameters (the allOf below).",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "highpass",
            "lowpass",
            "equalizer",
            "gain",
            "saturation",
            "reverb",
            "chorus",
            "pitch",
            "denoise",
            "dereverb",
            "trimSilence",
            "loudnorm"
          ],
          "description": "Effect type (closed vocabulary). dereverb has no exact ffmpeg counterpart: it is approximated with a soft downward expander (agate) that cuts the reverb tail between words; it does not remove reverb on top of speech."
        },
        "freqHz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000,
          "description": "highpass, lowpass, equalizer: cutoff or center frequency in Hz."
        },
        "widthOctaves": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "equalizer: band width in octaves."
        },
        "gainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 24,
          "description": "equalizer, gain: gain in dB."
        },
        "drive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "saturation: amount of soft saturation."
        },
        "impulse": {
          "$ref": "common.schema.json#/$defs/relativePath",
          "description": "reverb: impulse response file, relative to the effect chain's folder."
        },
        "wet": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "reverb, chorus: level of the processed signal."
        },
        "dry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "reverb: level of the unprocessed signal."
        },
        "delayMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "description": "chorus: delay in ms."
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "chorus: modulation depth."
        },
        "rateHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "chorus: modulation rate in Hz."
        },
        "semitones": {
          "type": "number",
          "minimum": -24,
          "maximum": 24,
          "description": "pitch: shift in semitones (moves formants too)."
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "denoise: noise reduction strength, 0 (none) to 1 (maximum; afftdn nr = 30 dB * strength, noise tracking and residual tracking on). dereverb: how hard the tail between words is cut, 0 to 1."
        },
        "thresholdDb": {
          "type": "number",
          "minimum": -90,
          "maximum": 0,
          "description": "trimSilence: level in dB (peak) below which the audio counts as silence."
        },
        "marginMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "description": "trimSilence: silence kept at the start and at the end, in ms."
        },
        "targetLufs": {
          "type": "number",
          "minimum": -70,
          "maximum": -5,
          "description": "loudnorm: integrated loudness target in LUFS (typical for speech: -16)."
        },
        "truePeakDb": {
          "type": "number",
          "minimum": -9,
          "maximum": 0,
          "description": "loudnorm: true peak ceiling in dBTP (default -1.5)."
        },
        "lra": {
          "type": "number",
          "minimum": 1,
          "maximum": 50,
          "description": "loudnorm: loudness range target in LU (default 11)."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "highpass"
              }
            }
          },
          "then": {
            "required": [
              "freqHz"
            ],
            "properties": {
              "type": true,
              "freqHz": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "lowpass"
              }
            }
          },
          "then": {
            "required": [
              "freqHz"
            ],
            "properties": {
              "type": true,
              "freqHz": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "equalizer"
              }
            }
          },
          "then": {
            "required": [
              "freqHz",
              "widthOctaves",
              "gainDb"
            ],
            "properties": {
              "type": true,
              "freqHz": true,
              "widthOctaves": true,
              "gainDb": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "gain"
              }
            }
          },
          "then": {
            "required": [
              "gainDb"
            ],
            "properties": {
              "type": true,
              "gainDb": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "saturation"
              }
            }
          },
          "then": {
            "required": [
              "drive"
            ],
            "properties": {
              "type": true,
              "drive": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "reverb"
              }
            }
          },
          "then": {
            "required": [
              "impulse"
            ],
            "properties": {
              "type": true,
              "impulse": true,
              "wet": true,
              "dry": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "chorus"
              }
            }
          },
          "then": {
            "required": [
              "delayMs",
              "depth",
              "rateHz"
            ],
            "properties": {
              "type": true,
              "delayMs": true,
              "depth": true,
              "rateHz": true,
              "wet": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "pitch"
              }
            }
          },
          "then": {
            "required": [
              "semitones"
            ],
            "properties": {
              "type": true,
              "semitones": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "denoise"
              }
            }
          },
          "then": {
            "required": [
              "strength"
            ],
            "properties": {
              "type": true,
              "strength": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "dereverb"
              }
            }
          },
          "then": {
            "required": [
              "strength"
            ],
            "properties": {
              "type": true,
              "strength": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "trimSilence"
              }
            }
          },
          "then": {
            "required": [
              "thresholdDb"
            ],
            "properties": {
              "type": true,
              "thresholdDb": true,
              "marginMs": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "loudnorm"
              }
            }
          },
          "then": {
            "required": [
              "targetLufs"
            ],
            "properties": {
              "type": true,
              "targetLufs": true,
              "truePeakDb": true,
              "lra": true
            },
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
