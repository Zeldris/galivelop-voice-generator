{
  "$schema": "gw/schema/gw.schema.json",
  "version": "0.5.1",
  "schemaVersion": 1,
  "language": "es",
  "visibleLanguages": [
    "es",
    "en"
  ],
  "logRows": false,
  "protectedBranch": "main",
  "pushToProtected": "pr",
  "install": [],
  "check": [
    "bash -n .githooks/pre-commit",
    "bash -n .githooks/pre-push",
    "python3 -m unittest discover -s tests -t ."
