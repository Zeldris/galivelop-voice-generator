{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "description": "A request to design a voice (type voice) or generate a line (type line). Type sound is reserved for F7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "type"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference so editors can validate and complete the file."
    },
    "key": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$",
      "description": "Order key: the voice key for a voice order, the line key for a line order."
    },
    "type": {
      "type": "string",
      "enum": [
        "voice",
        "line"
      ],
      "description": "Order type; sound is reserved for a later phase."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Random seed."
    },
    "testText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "voice: test sentence spoken in every take."
    },
    "designSheet": {
      "$ref": "#/$defs/designSheet",
      "description": "voice: design sheet the instruct is built from."
    },
    "voice": {
      "$ref": "#/$defs/key",
      "description": "line: key of the voice that speaks."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "line: text to speak."
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$",
      "description": "Key; slash-separated safe segments, no leading slash and no .. segments."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Random seed."
    },
    "designSheet": {
      "type": "object",
      "additionalProperties": false,
      "description": "Design sheet: the 12 template keys, all optional, plus free-form extra attributes.",
      "properties": {
        "gender": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: gender."
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: age."
        },
        "pitch": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: pitch."
        },
        "speed": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: speed."
        },
        "volume": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: volume."
        },
        "clarity": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: clarity."
        },
        "fluency": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: fluency."
        },
        "accent": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: accent."
        },
        "texture": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: texture."
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: emotion."
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: tone."
        },
        "personality": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: personality."
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-form extra attributes, name to text."
        }
      }
    }
  }
}
