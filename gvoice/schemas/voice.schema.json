{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice",
  "description": "voice.json of one voice inside a voice pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "key",
    "designSheet",
    "reference"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference so editors can validate and complete the file."
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Pack format version."
    },
    "key": {
      "$ref": "#/$defs/key",
      "description": "Voice key."
    },
    "designSheet": {
      "$ref": "#/$defs/designSheet"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Random seed."
    },
    "testText": {
      "type": "string",
      "minLength": 1,
      "description": "Test sentence of the chosen take."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio",
        "text"
      ],
      "properties": {
        "audio": {
          "$ref": "#/$defs/relativePath",
          "description": "Reference audio file, relative to the voice folder."
        },
        "text": {
          "$ref": "#/$defs/relativePath",
          "description": "Reference transcript file, relative to the voice folder."
        }
      }
    },
    "prints": {
      "type": "object",
      "description": "Prints by model id.",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spk",
          "rvq"
        ],
        "properties": {
          "spk": {
            "$ref": "#/$defs/relativePath"
          },
          "rvq": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "effects": {
      "$ref": "#/$defs/name",
      "description": "Name of the effect chain applied at playback."
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase letters, digits and hyphens."
    },
    "key": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$",
      "description": "Key; slash-separated safe segments, no leading slash and no .. segments."
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000-\\u001f\\u007f]+$",
      "description": "Relative path that cannot be absolute, start with ~, contain .. segments, backslashes or control characters."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Random seed."
    },
    "designSheet": {
      "type": "object",
      "additionalProperties": false,
      "description": "Design sheet: the 12 template keys, all optional, plus free-form extra attributes.",
      "properties": {
        "gender": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: gender."
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: age."
        },
        "pitch": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: pitch."
        },
        "speed": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: speed."
        },
        "volume": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: volume."
        },
        "clarity": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: clarity."
        },
        "fluency": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: fluency."
        },
        "accent": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: accent."
        },
        "texture": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: texture."
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: emotion."
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: tone."
        },
        "personality": {
          "type": "string",
          "minLength": 1,
          "description": "Design attribute: personality."
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-form extra attributes, name to text."
        }
      }
    }
  }
}
