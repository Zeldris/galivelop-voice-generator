{
  "$schema": "gw/schema/gw.schema.json",
  "version": "0.8.2",
  "schemaVersion": 1,
  "instructionLines": {"warn": 160},
  "language": "es",
  "workflowRepository": "https://github.com/Zeldris/Galivelop-workflow",
  "agentSignatures": false,
  "visibleLanguages": [
    "es",
    "en"
  ],
  "logRows": false,
  "protectedBranch": "main",
  "pushToProtected": "pr",
  "install": [],
  "check": [
    "bash -n .githooks/pre-commit",
    "bash -n .githooks/pre-push",
    "python3 -m unittest discover -s tests -t .",
    "python3 .claude/gw/scripts/ci-local.py --validate"
  ],
  "requireRetro": true,
  "content": [
    "^docs/",
    "\\.md$",
    "^\\.claude/skills/"
  ],
  "roadmap": false,
  "selector": {
    "cases": []
  },
  "designReferences": [],
  "protectedPaths": [],
  "staleRefs": [],
  "relatedTests": {
    "fast": [
      {
        "command": "python3 .claude/gw/scripts/tests-for.py --run {files}",
        "paths": "^(gvoice|tests)/"
      }
    ],
    "slow": []
  },
  "testMap": {
    "rules": [
      {
        "paths": "^gvoice/(?P<mod>\\w+)\\.py$",
        "tests": [
          "tests/test_{mod}.py"
        ]
      },
      {
        "paths": "^tests/test_\\w+\\.py$",
        "tests": [
          "{path}"
        ]
      }
    ],
    "command": "python3 -m unittest {files}"
  },
  "plan": [],
  "taskId": "[A-Z]{2,5}-\\d+",
  "doctorTestDirsIgnore": [
    ".git",
    "node_modules",
    ".claude/worktrees",
    ".claude/gw",
    "venv",
    ".venv",
    "env",
    ".tox",
    "site-packages",
    "__pycache__",
    ".claude/skills/gw-*"
  ],
  "pendingFile": "docs/records/pending.md",
  "agentsSkillsDir": ""
}
