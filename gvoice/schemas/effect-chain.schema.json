{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effect chain",
  "description": "Effect chain defined by its meaning in ffmpeg; the generator and the game apply the same filter graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference so editors can validate and complete the file."
    },
    "name": {
      "$ref": "#/$defs/name",
      "description": "Chain name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      },
      "description": "Steps applied in order."
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase letters, digits and hyphens."
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "One effect step. Which parameters each type uses is documented per parameter; the engine checks them.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "highpass",
            "lowpass",
            "equalizer",
            "gain",
            "saturation",
            "reverb",
            "chorus",
            "pitch"
          ],
          "description": "Effect type (closed vocabulary)."
        },
        "freqHz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000,
          "description": "highpass, lowpass, equalizer: cutoff or center frequency in Hz."
        },
        "widthOctaves": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "equalizer: band width in octaves."
        },
        "gainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 24,
          "description": "equalizer, gain: gain in dB."
        },
        "drive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "saturation: amount of soft saturation."
        },
        "impulse": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/~])(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000-\\u001f\\u007f]+$",
          "description": "reverb: impulse response file, relative to the effect chain's folder."
        },
        "wet": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "reverb, chorus: level of the processed signal."
        },
        "dry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "reverb: level of the unprocessed signal."
        },
        "delayMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "description": "chorus: delay in ms."
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "chorus: modulation depth."
        },
        "rateHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "chorus: modulation rate in Hz."
        },
        "semitones": {
          "type": "number",
          "minimum": -24,
          "maximum": 24,
          "description": "pitch: shift in semitones (moves formants too)."
        }
      }
    }
  }
}
